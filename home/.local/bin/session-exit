#!/bin/bash
# Save the open windows (session-save), then log out / reboot / shut down
# through Omarchy. The next login reopens them (session-restore, via the
# post-boot hook). Wired into the Omarchy menu's System entries by
# ~/.config/omarchy/extensions/omarchy-menu.jsonc.
#
#   session-exit <reboot|shutdown|logout>
#
# Linux + Omarchy only.
set -uo pipefail

case ${1:-} in
  reboot | shutdown | logout) ;;
  *) echo "Usage: session-exit <reboot|shutdown|logout>" >&2; exit 2 ;;
esac

if [[ $(uname -s) != Linux ]] || ! command -v omarchy-system >/dev/null; then
  echo "session-exit: Linux/Omarchy only" >&2
  exit 1
fi

# Keep session-save's errors: a failure here is otherwise invisible.
log="${XDG_STATE_HOME:-$HOME/.local/state}/session-restore/save.log"
mkdir -p "${log%/*}"
{ printf '%s session-exit %s\n' "$(date '+%F %T')" "$1"; } >>"$log"
if ! "$HOME/.local/bin/session-save" >>"$log" 2>&1; then
  reason=$(tail -n 1 "$log")
  omarchy-notification-send -u critical "Session not saved" "Continuing with $1 anyway. ${reason:0:160} (see $log)" 2>/dev/null || true
fi

exec omarchy-system "$1"
